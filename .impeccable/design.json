  "narrative": {
    "northStar": "The Operational Console",
    "overview": "The Operational Console treats the portfolio as a calm, production-minded workspace: direct commands establish structure, system states carry meaning, and shipped work remains the evidence. Its terminal language is precise and restrained rather than nostalgic or theatrical, giving technical hiring teams an interface they can scan quickly and trust.\n\nThe system stays spacious even though its controls are compact. Carbon and Paper surfaces support equal light and dark expressions, Operational Green marks the few moments that deserve attention, and square geometry keeps every interaction utilitarian and exact. Motion confirms state and sequence without becoming spectacle.",
    "keyCharacteristics": [
      "Monospaced, command-led hierarchy with plainspoken labels.",
      "Warm near-black and off-white surfaces separated by hairlines and tonal steps.",
      "Sparse green signals for commands, active states, focus, and healthy status.",
      "Square panels and controls, with circles reserved for status indicators.",
      "Quiet, reduced-motion-safe transitions that preserve reading flow."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Operational Green appears only on commands, interaction states, and healthy status; its rarity is what gives it authority.",
        "section": "colors"
      },
      {
        "name": "The Paired Surface Rule",
        "body": "Every neutral role must have an equivalent light and dark expression before it is introduced into the system.",
        "section": "colors"
      },
      {
        "name": "The One Typeface Rule",
        "body": "Use JetBrains Mono for every visible text role; hierarchy comes from weight, scale, tracking, and color rather than a second family.",
        "section": "typography"
      },
      {
        "name": "The Command Leads Rule",
        "body": "Section headings begin with a prompt or command phrase so the interface always explains what the following content represents.",
        "section": "typography"
      },
      {
        "name": "The Flat-by-Default Rule",
        "body": "Use borders and tonal layering for depth; reserve shadow for an overlay that must remain legible above scrolling content.",
        "section": "elevation"
      },
      {
        "name": "The Square Workbench Rule",
        "body": "Use square corners for every container and control; use a full circle only for a status light or terminal indicator.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do use Operational Green only for commands, active interaction states, focus, and healthy status.",
      "Do preserve a centered 56rem reading column with 1.5rem inline gutters and generous section spacing.",
      "Do use hairlines and tonal surface steps before introducing elevation.",
      "Do keep every interaction keyboard-usable and collapse decorative motion for reduced-motion users.",
      "Do write labels as concise commands, paths, filenames, or bracketed actions when the context supports them."
    ],
    "donts": [
      "Don't round cards, buttons, inputs, image frames, or navigation controls.",
      "Don't spread green across large backgrounds or use it as general decoration.",
      "Don't add gradients, glass panels, or broad card shadows to create hierarchy.",
      "Don't mix in a second display or body typeface.",
      "Don't turn the terminal metaphor into fake shell complexity that obscures portfolio evidence."
    ]
  }
}
