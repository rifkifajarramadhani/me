      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--hairline);background:color-mix(in srgb,var(--surface-1) 20%,transparent);padding:6px 24px;color:var(--ink-subtle);font:400 14px/1.5 'JetBrains Mono',ui-monospace,monospace;backdrop-filter:blur(16px)}.ds-nav a{color:inherit;text-decoration:none;transition:color 150ms,border-color 150ms}.ds-nav a:hover,.ds-nav a:focus-visible{color:var(--primary);outline:none}.ds-nav-home{display:grid;place-items:center;width:44px;height:44px}.ds-nav-home img{outline:1px solid var(--hairline)}.ds-nav .ds-nav-home:hover{outline:1px solid var(--hairline-strong)}.ds-nav .ds-nav-home:focus-visible{outline:2px solid var(--primary)}.ds-nav-links{display:flex;align-items:center;gap:24px}.ds-nav-resume{border:1px solid var(--hairline-strong);padding:6px 12px}.ds-nav-resume:hover,.ds-nav-resume:focus-visible{border-color:var(--primary)}"
