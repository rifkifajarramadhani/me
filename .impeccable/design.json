      "css": ".ds-action{border:1px solid var(--hairline-strong);border-radius:0;background:transparent;padding:8px 16px;color:var(--ink-subtle);font:400 14px/1.5 'JetBrains Mono',ui-monospace,monospace;transition:border-color 150ms,color 150ms}.ds-action:hover,.ds-action:focus-visible{border-color:var(--primary);color:var(--primary);outline:none}.ds-action:focus-visible{box-shadow:0 0 0 2px var(--canvas),0 0 0 3px var(--primary)}.ds-action:active{color:var(--primary-hover)}"
