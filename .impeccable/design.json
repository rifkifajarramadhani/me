    {
      "name": "Terminal Window",
      "kind": "custom",
      "refersTo": "terminal-window",
      "description": "Signature hero container for identity, role, tagline, and primary paths.",
      "html": "<section class=\"ds-terminal\"><header class=\"ds-terminal-bar\"><span class=\"ds-terminal-lights\"><i class=\"ds-light ds-danger\"></i><i class=\"ds-light ds-warning\"></i><i class=\"ds-light ds-success\"></i></span><span>~/portfolio</span></header><div class=\"ds-terminal-body\"><p><span class=\"ds-prompt\">$</span> whoami <strong>Rifki Fajar Ramadhani</strong></p><p><span class=\"ds-prompt\">$</span> cat role.txt <span class=\"ds-ink\">Full-Stack Engineer</span></p><p><span class=\"ds-prompt\">$</span> echo <span class=\"ds-primary\">\"build things for the web.\"</span><i class=\"ds-caret\"></i></p></div></section>",
      "css": ".ds-terminal{overflow:hidden;border:1px solid var(--hairline-strong);border-radius:0;background:var(--surface-1);color:var(--ink-subtle);font:400 14px/1.7 'JetBrains Mono',ui-monospace,monospace}.ds-terminal-bar{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--hairline);background:var(--surface-2);padding:8px 12px;color:var(--ink-tertiary);font-size:12px}.ds-terminal-lights{display:flex;gap:6px}.ds-light{width:10px;height:10px;border-radius:9999px}.ds-danger{background:var(--danger)}.ds-warning{background:var(--warning)}.ds-success{background:var(--success)}.ds-terminal-body{padding:24px}.ds-terminal-body p{margin:0 0 12px}.ds-terminal-body strong,.ds-ink{color:var(--ink)}.ds-prompt{color:var(--prompt)}.ds-primary{color:var(--primary)}.ds-caret{display:inline-block;width:.55ch;height:1.05em;margin-left:.15ch;vertical-align:-.12em;background:var(--primary)}"
    },
