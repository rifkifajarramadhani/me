      "css": ".ds-tabs{display:flex;gap:8px;font:400 14px/1.5 'JetBrains Mono',ui-monospace,monospace}.ds-tab{border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;padding:4px 8px;color:var(--ink-subtle);transition:border-color 150ms,color 150ms}.ds-tab:hover,.ds-tab:focus-visible{color:var(--ink);outline:none}.ds-tab:focus-visible{box-shadow:0 2px 0 var(--primary)}.ds-tab-active{border-color:var(--primary);color:var(--primary)}.ds-tab-active::before{content:'[_'}.ds-tab-active::after{content:'_]'}"
