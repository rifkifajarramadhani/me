{
  "name": "me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run --cwd web dev",
    "dev:api": "bun run --cwd api dev",
    "build": "bun run --cwd web build && bun run --cwd api build",
    "preview": "bun run --cwd web preview",
    "lint": "bun run --bun eslint .",
    "typecheck": "bun run --cwd web typecheck && bun run --cwd api typecheck",
    "test": "bun run --cwd web test && bun run --cwd api test",
    "verify:publishing": "bun run --cwd web verify:publishing",
    "check": "bun run lint && bun run typecheck && bun run test && bun run verify:publishing"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-astro": "^3",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "workspaces": [
    "web",
    "api"
  ]
}
