---
import AdminLayout from './AdminLayout.astro'
import scriptUrl from './login.js?url&no-inline'
---

<AdminLayout title="Admin sign-in" scriptUrl={scriptUrl}>
  <p id="sign-in-error" role="alert" hidden></p>
  <p>Sign in with the portfolio owner’s GitHub account.</p>
  <a href="/admin/auth/github">Sign in with GitHub</a>
</AdminLayout>
