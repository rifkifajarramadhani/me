---
import { ShieldCheck } from 'lucide-react'
import AdminIcon from './AdminIcon.astro'
import AdminWorkspace from './AdminWorkspace.astro'
import { POST_STATUSES, STATUS_LABELS } from './posts/post-types'
---

<AdminWorkspace title="Dashboard" documentTitle="Portfolio admin">
  <Fragment slot="head">
    <script>
      import './dashboard'
    </script>
  </Fragment>

  <section class="dashboard-posts" aria-labelledby="dashboard-posts-title">
    <header class="dashboard-posts-header">
      <h2 id="dashboard-posts-title" tabindex="-1">
        Posts
      </h2>
      <a href="/admin/posts/">
        All posts <span id="dashboard-post-total" hidden></span>
      </a>
    </header>

    <p id="dashboard-posts-loading" role="status">
      Loading posts…
    </p>
    <div id="dashboard-posts-error" hidden>
      <p role="alert">Could not load posts.</p>
      <button id="dashboard-posts-retry" type="button">
        Try again
      </button>
    </div>

    <div id="dashboard-posts-results" hidden>
      <ul
        class="dashboard-post-counts"
        aria-label="Post counts by status"
        role="list"
      >
        {POST_STATUSES.map((status) => (
          <li>
            <a href={`/admin/posts/?status=${status}`}>
              {STATUS_LABELS[status]}
              <span data-dashboard-post-count={status}></span>
            </a>
          </li>
        ))}
      </ul>

      <div id="dashboard-posts-empty" hidden>
        <p>No posts yet. Start with your first draft.</p>
        <a href="/admin/posts/edit/">Write a post</a>
      </div>

      <section
        id="dashboard-recent-posts"
        aria-labelledby="dashboard-recent-title"
        hidden
      >
        <h3 id="dashboard-recent-title">Recently updated</h3>
        <ul
          id="dashboard-post-rows"
          class="dashboard-post-rows"
          role="list"
        ></ul>
      </section>
    </div>

    <template id="dashboard-post-template">
      <li>
        <a class="dashboard-post-link"></a>
        <span class="post-status"></span>
        <time></time>
      </li>
    </template>
  </section>

  <section
    id="owner-panel"
    class="admin-session"
    aria-labelledby="session-title"
  >
    <span class="admin-session-icon">
      <AdminIcon icon={ShieldCheck} size={22} />
    </span>
    <div>
      <h2 id="session-title">GitHub session</h2>
      <p>Signed in to the portfolio admin.</p>
    </div>
    <span class="admin-session-state">Active</span>
  </section>
</AdminWorkspace>
