---
import script from './admin.js?url&no-inline'
import stylesheet from './admin.css?url'

interface Props {
  title: string
}

const { title } = Astro.props
const workspace = Astro.slots.has('workspace')
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="stylesheet" href={stylesheet} />
    <script is:inline type="module" src={script}></script>
  </head>
  <body class:list={[{ 'admin-workspace-page': workspace }]}>
    {workspace ? (
      <slot name="workspace" />
    ) : (
      <main class="sign-in-panel">
        <header>~/portfolio/admin</header>
        <section aria-labelledby="page-title">
          <h1 id="page-title">
            <span aria-hidden="true">&gt;</span> {title}
          </h1>
          <slot />
        </section>
      </main>
    )}
  </body>
</html>
