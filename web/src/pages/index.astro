---
import Layout from '@/layouts/Layout.astro'
import Portfolio from '@/components/Portfolio.astro'
import { createSitePublishing } from '@/lib/site-publishing'
import { serializeJsonLd } from '@/lib/json-ld'
import {
  alternateSiteNames,
  jobTitle,
  name,
  socialLinks,
} from '@/lib/site'

const publishing = createSitePublishing()
const homePageUrl = publishing.absoluteUrl()
const websiteId = `${homePageUrl}#website`
const personId = `${homePageUrl}#person`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name,
      jobTitle,
      url: homePageUrl,
      sameAs: [socialLinks.github, socialLinks.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name,
      alternateName: alternateSiteNames,
      url: homePageUrl,
      about: { '@id': personId },
    },
  ],
}
---

<Layout>
  <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
  <Portfolio />
</Layout>
