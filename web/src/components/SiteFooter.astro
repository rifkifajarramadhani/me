---
import { shortName } from '@/lib/site'

interface Props {
  stickyDesktop?: boolean
}

const { stickyDesktop = false } = Astro.props
const year = new Date().getFullYear()
---

<footer
  class:list={[
    'relative z-[1] hidden h-9 items-stretch border-t border-hairline bg-surface-1 font-mono text-xs md:flex',
    stickyDesktop ? 'portfolio-status-footer text-ink-subtle' : 'text-ink-tertiary',
  ]}
>
  <span
    class:list={[
      'flex h-full items-center px-3 font-bold text-primary-foreground',
      stickyDesktop ? 'bg-primary-hover dark:bg-primary' : 'bg-primary',
    ]}
  >
    NORMAL
  </span>
  {stickyDesktop && (
    <button
      type="button"
      data-hero-dock
      aria-label="Restore terminal"
      class="hero-dock flex h-full items-center gap-1.5 border-r border-hairline px-3 text-ink-subtle transition-colors hover:bg-surface-2 hover:text-primary focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
      hidden
    >
      <span class="text-prompt" aria-hidden="true">▣</span>
      ~/portfolio
    </button>
  )}
  <div class="flex flex-1 items-center justify-between px-4">
    <span class="text-ink-subtle">~/{shortName.toLowerCase()}</span>
    <span class="flex items-center gap-4">
      <span>© {year}</span>
      <span class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-success"></span>
        operational
      </span>
    </span>
  </div>
</footer>
<footer class="relative z-[1] border-t border-hairline bg-surface-1 py-4 text-center font-mono text-xs text-ink-tertiary md:hidden">
  <span class="text-ink-subtle">~/{shortName.toLowerCase()}</span>
  <span class="mx-2 text-prompt">·</span>
  <span>© {year}</span>
</footer>

<style is:global>
  @media screen and (min-width: 48rem) {
    html:has(.portfolio-status-footer) {
      --portfolio-status-height: 2.25rem;
      scroll-padding-bottom: calc(var(--portfolio-status-height) + 0.5rem);
    }

    .portfolio-status-footer {
      position: sticky;
      bottom: 0;
      z-index: 2;
      height: var(--portfolio-status-height);
    }
  }
</style>
