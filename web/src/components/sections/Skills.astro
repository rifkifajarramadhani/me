---
import SKILLS from '@/data/skills'
import Reveal from '@/components/Reveal.astro'
import SectionHeading from '@/components/SectionHeading.astro'

const groups = SKILLS.map((group) => ({
  ...group,
  slug: group.field.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
}))
---

<section id="skills" class="mx-auto max-w-4xl px-6 py-24">
  <Reveal>
    <SectionHeading command="ls skills/" kicker="skills" />
  </Reveal>

  {
    groups.map((group, index) => (
      <Reveal>
        <div
          class:list={[index > 0 && 'mt-12']}
          role="group"
          aria-labelledby={`skills-${group.slug}`}
        >
          <div class="mb-4 flex items-center gap-3 font-mono text-sm">
            <h3 id={`skills-${group.slug}`} class="font-bold text-ink">
              {group.slug}<span class="text-prompt">/</span>
            </h3>
            <span class="h-px flex-1 bg-hairline" aria-hidden="true" />
            <span class="text-xs text-ink-subtle">
              {group.skills.length} items
            </span>
          </div>

          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
            {group.skills.map(({ skill, icon }) => (
              <li class="group flex flex-col items-center gap-3 border border-hairline bg-surface-1 p-5 transition-colors hover:border-primary">
                <svg
                  class="h-8 w-8 text-ink-subtle transition-colors group-hover:text-primary"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={icon.path} fill="currentColor" />
                </svg>
                <span class="text-xs text-ink-subtle">{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      </Reveal>
    ))
  }
</section>
