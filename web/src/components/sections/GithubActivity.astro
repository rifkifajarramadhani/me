---
import SectionHeading from '@/components/SectionHeading.astro'
import { createSitePublishing } from '@/lib/site-publishing'
import { socialLinks } from '@/lib/site'

const hasActivityApi = createSitePublishing().profile === 'apex'
---

<section
  id="github-activity"
  aria-label="GitHub activity"
  class="mx-auto max-w-4xl px-6 py-24"
>
  <SectionHeading command="git log --stat" />

  <div
    class="panel"
    data-github-activity={
      hasActivityApi ? '/api/github/contributions' : undefined
    }
  >
    <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-2 border-b border-hairline bg-surface-2 px-4 py-2 sm:px-5">
      <p class="text-xs text-ink-subtle">
        Public GitHub commits · Last 365 days
      </p>
      <a
        class="bracket-link inline-flex min-h-11 items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        href={socialLinks.github}
      >
        [ view on github ]
      </a>
    </div>

    {hasActivityApi && (
      <div class="commit-body p-4 sm:p-5">
        <p data-commit-status role="status" class="text-sm text-ink-subtle">
          View commit activity on GitHub.
        </p>
        <div hidden data-commit-content>
          <dl
            class="mb-5 grid grid-cols-3 gap-2 pb-5 sm:gap-5"
            aria-label="Commit statistics for the last 365 days"
          >
            <div>
              <dt class="text-xs text-ink-subtle">Commits</dt>
              <dd
                data-total-commits
                class="mt-1 text-2xl font-semibold tabular-nums text-ink"
              ></dd>
            </div>
            <div class="border-l border-hairline pl-2 sm:pl-5">
              <dt class="text-xs text-ink-subtle">Current streak</dt>
              <dd class="mt-1">
                <span
                  data-current-streak
                  class="text-2xl font-semibold tabular-nums text-ink"
                ></span>{' '}
                <span data-current-unit class="text-xs text-ink-subtle">
                  days
                </span>
              </dd>
            </div>
            <div class="border-l border-hairline pl-2 sm:pl-5">
              <dt class="text-xs text-ink-subtle">Longest streak</dt>
              <dd class="mt-1">
                <span
                  data-longest-streak
                  class="text-2xl font-semibold tabular-nums text-ink"
                ></span>{' '}
                <span data-longest-unit class="text-xs text-ink-subtle">
                  days
                </span>
              </dd>
            </div>
          </dl>

          <div class="commit-scroll" data-commit-scroll>
            <div
              class="commit-calendar"
              data-commit-calendar
              role="grid"
              aria-label="Daily public commits in UTC"
              aria-describedby="commit-calendar-help"
            ></div>
          </div>
          <p id="commit-calendar-help" class="sr-only">
            Use arrow keys to move between days and weeks.
          </p>

          <div class="mt-3 flex min-h-8 flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs text-ink-subtle">
            <p data-commit-detail aria-hidden="true"></p>
            <div
              class="flex items-center gap-1.5"
              aria-label="Color scale from fewer to more commits"
            >
              <span>Less</span>
              <span
                class="commit-swatch"
                data-level="0"
                aria-hidden="true"
              ></span>
              <span
                class="commit-swatch"
                data-level="1"
                aria-hidden="true"
              ></span>
              <span
                class="commit-swatch"
                data-level="2"
                aria-hidden="true"
              ></span>
              <span
                class="commit-swatch"
                data-level="3"
                aria-hidden="true"
              ></span>
              <span
                class="commit-swatch"
                data-level="4"
                aria-hidden="true"
              ></span>
              <span>More</span>
            </div>
          </div>

          <p class="mt-2 border-t border-hairline pt-3 text-xs text-ink-subtle">
            <span data-commit-freshness>Updated</span>{' '}
            <time data-commit-updated></time> <span>UTC</span>
          </p>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  [data-github-activity] {
    --commit-0: var(--surface-3);
    --commit-1: color-mix(in srgb, var(--ink) 30%, var(--surface-1));
    --commit-2: color-mix(in srgb, var(--ink) 48%, var(--surface-1));
    --commit-3: color-mix(in srgb, var(--ink) 69%, var(--surface-1));
    --commit-4: var(--ink);
  }

  .commit-body {
    min-block-size: 21rem;
  }

  [data-commit-status]:not([hidden]) {
    display: grid;
    min-block-size: 18rem;
    align-content: center;
  }

  .commit-scroll {
    --day-size: 0.6875rem;
    --day-gap: 0.1875rem;
    --weekday: 2.25rem;
    overflow-x: auto;
    scroll-padding-inline-start: calc(var(--weekday) + var(--day-gap));
  }

  .commit-calendar {
    display: grid;
    min-inline-size: calc(
      var(--weekday) + 53 * (var(--day-size) + var(--day-gap))
    );
    gap: var(--day-gap);
    padding-block: 0.125rem;
    color: var(--ink-subtle);
    font-size: 0.625rem;
    line-height: 1;
  }

  .commit-calendar :global(.commit-row) {
    display: grid;
    grid-template-columns: var(--weekday) repeat(53, minmax(0, 1fr));
    align-items: center;
    column-gap: var(--day-gap);
    min-block-size: var(--day-size);
  }

  .commit-calendar :global(.commit-month) {
    min-block-size: 1rem;
    grid-row: 1;
  }

  .commit-calendar :global(.commit-weekday) {
    position: sticky;
    z-index: 1;
    inset-inline-start: 0;
    grid-column: 1;
    align-content: center;
    block-size: 100%;
    background: var(--surface-1);
  }

  .commit-calendar :global(.commit-months)::before {
    position: sticky;
    z-index: 1;
    grid-area: 1 / 1;
    inset-inline-start: 0;
    block-size: 100%;
    background: var(--surface-1);
    content: '';
  }

  .commit-calendar :global(.commit-day) {
    display: block;
    inline-size: 100%;
    block-size: var(--day-size);
    outline-offset: -1px;
  }

  .commit-calendar :global(.commit-day:hover),
  .commit-calendar :global(.commit-day:focus-visible),
  .commit-calendar :global(.commit-day[aria-pressed='true']) {
    outline: 2px solid var(--primary);
  }

  .commit-calendar :global(.commit-day)::before,
  .commit-swatch {
    display: block;
    background: var(--commit-level, var(--commit-0));
  }

  .commit-calendar :global(.commit-day)::before {
    content: '';
    block-size: 100%;
  }

  .commit-swatch {
    inline-size: 0.625rem;
    block-size: 0.625rem;
  }

  [data-github-activity] :global([data-level='1']) {
    --commit-level: var(--commit-1);
  }
  [data-github-activity] :global([data-level='2']) {
    --commit-level: var(--commit-2);
  }
  [data-github-activity] :global([data-level='3']) {
    --commit-level: var(--commit-3);
  }
  [data-github-activity] :global([data-level='4']) {
    --commit-level: var(--commit-4);
  }

  @media (max-width: 40rem), (pointer: coarse) {
    .commit-body dt {
      min-block-size: 2rem;
    }

    .commit-scroll {
      --day-size: 1.5rem;
    }
    .commit-calendar :global(.commit-day)::before {
      box-sizing: border-box;
      border: 0.125rem solid var(--surface-1);
    }
    .commit-body {
      min-block-size: 27rem;
    }
    [data-commit-status]:not([hidden]) {
      min-block-size: 24rem;
    }
  }

  @media (forced-colors: active) {
    [data-github-activity] {
      --commit-0: Canvas;
      --commit-1: GrayText;
      --commit-2: GrayText;
      --commit-3: CanvasText;
      --commit-4: CanvasText;
    }
    .commit-calendar :global(.commit-day)::before,
    .commit-swatch {
      border: 1px solid CanvasText;
      forced-color-adjust: none;
    }
    .commit-calendar :global(.commit-day:focus-visible) {
      outline-color: Highlight;
    }
  }
</style>

<script>
  import { mountGithubActivity } from '@/lib/github-activity'

  const panel = document.querySelector<HTMLElement>('[data-github-activity]')
  if (panel) mountGithubActivity(panel)
</script>
