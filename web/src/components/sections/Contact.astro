---
import Reveal from '@/components/Reveal.astro'
import CommandHeading from '@/components/CommandHeading.astro'
import { socialLinks } from '@/lib/site'

const socials = [
  {
    href: socialLinks.email,
    label: 'email',
    accessibleLabel: 'Email Rifki',
    external: false,
  },
  {
    href: socialLinks.github,
    label: 'github',
    accessibleLabel: 'GitHub profile (opens in a new tab)',
    external: true,
  },
  {
    href: socialLinks.linkedin,
    label: 'linkedin',
    accessibleLabel: 'LinkedIn profile (opens in a new tab)',
    external: true,
  },
]
---

<section id="contact" class="mx-auto max-w-2xl px-6 py-32 text-center">
  <Reveal>
    <CommandHeading
      command="./contact.sh"
      kicker="contact"
      class="mb-6 text-left sm:text-center"
    />
    <p class="mx-auto max-w-lg text-left leading-[1.7] text-ink-muted sm:text-center">
      I'm currently open to new opportunities and collaborations. Whether you
      have a question, a project in mind, or just want to say hi, my inbox is
      always open — I'll do my best to get back to you!
    </p>
    <a
      href={socialLinks.email}
      class="mt-10 inline-flex min-h-11 items-center border border-hairline-strong px-6 py-3 font-mono text-sm text-ink-subtle transition-colors hover:border-primary hover:text-primary"
    >
      <span class="text-prompt">[</span> say hello{' '}
      <span class="text-prompt">]</span>
    </a>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
      {socials.map(({ href, label, accessibleLabel, external }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          aria-label={accessibleLabel}
          class="inline-flex min-h-11 items-center px-1 font-mono text-sm text-ink-subtle transition-colors hover:text-primary"
        >
          <span class="text-prompt">[</span> {label}{' '}
          <span class="text-prompt">]</span>
        </a>
      ))}
    </div>
  </Reveal>
</section>
