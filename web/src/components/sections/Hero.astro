---
import PAST_ROLES from '@/data/experience'
import PROJECTS from '@/data/projects'
import SKILLS from '@/data/skills'
import { serializeJsonLd } from '@/lib/json-ld'
import { name, jobTitle, socialLinks } from '@/lib/site'
import { createSitePublishing } from '@/lib/site-publishing'
import { projectSlug, type ShellData } from '@/lib/terminal-shell'

const taglines = ['build things for the web.', 'build digital experiences.']
const socials = [
  {
    href: socialLinks.github,
    label: 'github',
    accessibleLabel: 'GitHub profile (opens in a new tab)',
    external: true,
  },
  {
    href: socialLinks.email,
    label: 'email',
    accessibleLabel: 'Email Rifki',
    external: false,
  },
  {
    href: socialLinks.linkedin,
    label: 'linkedin',
    accessibleLabel: 'LinkedIn profile (opens in a new tab)',
    external: true,
  },
]
const { assets } = createSitePublishing()
const shellData: ShellData = {
  name,
  jobTitle,
  resumeUrl: assets.resume,
  links: socialLinks,
  projects: PROJECTS.map((project) => ({
    slug: projectSlug(project.name),
    name: project.name,
    description: project.description,
    tags: project.tags ?? [],
    liveLink: project.liveLink || undefined,
    repoUrl: project.repoUrl !== '#' ? project.repoUrl : undefined,
  })),
  experience: PAST_ROLES.map(({ company, country, role, startDate, endDate }) => ({
    company,
    country,
    role,
    startDate,
    endDate,
  })),
  skills: SKILLS.map(({ field, skills }) => ({
    field,
    skills: skills.map(({ skill }) => skill),
  })),
}

const windowControls = [
  { action: 'close', label: 'Close terminal', glyph: '×', tone: 'bg-danger' },
  { action: 'minimize', label: 'Minimize terminal', glyph: '−', tone: 'bg-warning' },
  {
    action: 'maximize',
    label: 'Maximize to interactive shell',
    glyph: '+',
    tone: 'bg-success',
  },
]
---

<section id="hero" class="hero-section relative">
  <div class="hero-content relative z-10 mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-5 pt-24 pb-24 sm:px-6 sm:pt-28 sm:pb-28">
    <div class="hero-stage relative" data-hero-window>
      <div class="terminal-window hero-enter" data-hero-terminal>
        <div class="terminal-titlebar">
          <div class="hero-controls" role="group" aria-label="Terminal window controls">
            {windowControls.map(({ action, label, glyph, tone }) => (
              <button
                type="button"
                class="hero-control"
                data-window-action={action}
                aria-label={label}
              >
                <span class:list={['hero-control-dot', tone]} aria-hidden="true">
                  <span class="hero-control-glyph">{glyph}</span>
                </span>
              </button>
            ))}
          </div>
          <span class="font-mono text-xs text-ink-subtle" aria-hidden="true">
            ~/portfolio
          </span>
        </div>

        <div class="p-6 sm:p-8">
          <div class="hero-transcript" data-hero-transcript>
            <div class="hero-line">
              <p class="hero-command" aria-hidden="true">
                <span class="text-prompt">$</span>
                <span class="text-ink-subtle">whoami</span>
              </p>
              <h1 class="font-mono text-2xl font-semibold leading-tight tracking-[-0.02em] text-ink">
                {name}
              </h1>
            </div>

            <div class="hero-line">
              <p class="hero-command" aria-hidden="true">
                <span class="text-prompt">$</span>
                <span class="text-ink-subtle">cat role.txt</span>
              </p>
              <p class="font-mono text-sm leading-relaxed text-ink sm:text-base">
                <span class="sr-only">Role: </span>
                {jobTitle}
              </p>
            </div>

            <div
              id="tagline-rotator"
              class="hero-line"
              data-taglines={JSON.stringify(taglines)}
            >
              <p class="hero-command" aria-hidden="true">
                <span class="text-prompt">$</span>
                <span class="text-ink-subtle">echo</span>
              </p>
              <p class="flex min-w-0 items-baseline font-mono text-sm leading-relaxed sm:text-base">
                <span data-tagline class="tagline text-primary">
                  &quot;{taglines[0]}&quot;
                </span>
                <span
                  class="ml-[0.55ch] inline-block h-[1.05em] w-[0.55ch] shrink-0 translate-y-[0.12em] animate-command-caret bg-primary motion-reduce:animate-none"
                  aria-hidden="true"
                ></span>
              </p>
            </div>
          </div>

          <p class="mt-6 max-w-[68ch] font-mono text-sm leading-[1.75] text-ink-muted sm:text-[0.9375rem]">
            Full-stack software engineer based in Indonesia, building web
            applications since 2018 with TypeScript, Golang, PHP, React, Vue, and
            Tailwind CSS.
          </p>

          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
            <a
              href="#work"
              class="hero-primary-action inline-flex min-h-11 items-center border border-hairline-strong px-4 py-2 font-mono text-sm text-ink-subtle transition-colors hover:border-primary hover:text-primary"
            >
              <span class="text-prompt">[</span> view work{' '}
              <span class="text-prompt">]</span>
            </a>
            <div class="flex flex-wrap items-center gap-x-1 gap-y-1 sm:gap-x-2">
              {socials.map(({ href, label, accessibleLabel, external }) => (
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  aria-label={accessibleLabel}
                  class="hero-secondary-action inline-flex min-h-11 items-center px-1 font-mono text-sm text-ink-subtle transition-colors hover:text-primary"
                >
                  <span class="text-prompt">[</span> {label}{' '}
                  <span class="text-prompt">]</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div
        class="hero-restart-log"
        data-hero-restart-log
        aria-hidden="true"
        hidden
      ></div>
      <div class="hero-stopped" data-hero-stopped hidden>
        <p class="font-mono text-sm text-ink-muted" aria-hidden="true">
          <span class="text-prompt">[1]+</span> Stopped
          <span class="ml-[3ch] text-ink-subtle">~/portfolio</span>
        </p>
        <button
          type="button"
          data-hero-restore
          aria-label="Restore terminal"
          class="hero-primary-action inline-flex min-h-11 w-fit items-center gap-[1ch] border border-hairline-strong px-4 py-2 font-mono text-sm text-ink-subtle transition-colors hover:border-primary hover:text-primary"
        >
          <span class="text-prompt">$</span> fg
          <span class="text-ink-tertiary" aria-hidden="true"># bring it back</span>
        </button>
      </div>
      <p class="sr-only" role="status" data-hero-status></p>
    </div>
  </div>

  <dialog
    class="hero-shell terminal-window"
    data-hero-shell
    aria-label="Interactive portfolio shell"
  >
    <div class="terminal-titlebar">
      <div class="hero-controls" role="group" aria-label="Shell window controls">
        <button type="button" class="hero-control" data-shell-exit aria-label="Exit shell">
          <span class="hero-control-dot bg-danger" aria-hidden="true">
            <span class="hero-control-glyph">×</span>
          </span>
        </button>
        <span class="hero-control" aria-hidden="true">
          <span class="hero-control-dot bg-warning opacity-40"></span>
        </span>
        <button
          type="button"
          class="hero-control"
          data-shell-exit
          aria-label="Restore terminal size"
        >
          <span class="hero-control-dot bg-success" aria-hidden="true">
            <span class="hero-control-glyph">−</span>
          </span>
        </button>
      </div>
      <span class="font-mono text-xs text-ink-subtle" aria-hidden="true">
        visitor@portfolio: ~
      </span>
    </div>
    <div class="hero-shell-body" data-shell-body>
      <div role="log" aria-live="polite" data-shell-log></div>
      <form class="hero-shell-prompt" data-shell-form>
        <label for="hero-shell-input" class="shrink-0"
          ><span class="text-primary">visitor@portfolio</span><span
            class="text-ink-subtle">:~$</span
          ><span class="sr-only"> command</span></label
        >
        <input
          id="hero-shell-input"
          data-shell-input
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="send"
          class="min-w-0 flex-1 bg-transparent text-ink caret-primary outline-none"
        />
      </form>
    </div>
    <script
      type="application/json"
      data-shell-data
      set:html={serializeJsonLd(shellData)}
    />
  </dialog>

  <div class="hero-achievement terminal-window" data-hero-achievement aria-hidden="true" hidden>
    <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-primary">
      ★ achievement unlocked
    </p>
    <p class="mt-1 font-mono text-sm text-ink">window manager</p>
    <p class="mt-1 font-mono text-xs text-ink-subtle">
      closed, minimized, and maximized. you know your way around a desktop.
    </p>
  </div>

  <a
    href="#about"
    class="hero-scroll absolute z-10 bottom-5 left-1/2 inline-flex min-h-11 -translate-x-1/2 items-center px-2 font-mono text-xs text-ink-subtle transition-colors hover:text-primary sm:bottom-7"
    aria-label="Scroll to about"
  >
    <span class="text-prompt">[</span> scroll <span class="text-prompt">]</span>
  </a>
</section>

<style>
  .hero-content {
    min-height: calc(100svh - var(--portfolio-status-height, 0px));
  }

  .hero-transcript {
    display: grid;
    gap: 1rem;
  }

  .hero-line {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0.75rem;
  }

  .hero-command {
    display: flex;
    gap: 0.55ch;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .hero-enter {
    animation: hero-enter 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-restart-log {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.5rem 0.25rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .hero-restart-log[hidden] {
    display: none;
  }

  .hero-stopped {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.5rem 0.25rem;
  }

  .hero-stopped[hidden] {
    display: none;
  }

  .hero-shell {
    position: fixed;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: clamp(0.5rem, 3vw, 2rem);
    padding: 0;
    flex-direction: column;
    color: var(--ink);
  }

  .hero-shell[open] {
    display: flex;
  }

  .hero-shell::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(2px);
  }

  .hero-shell-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    cursor: text;
  }

  .hero-shell-prompt {
    display: flex;
    gap: 1ch;
    align-items: baseline;
  }

  .hero-achievement {
    position: fixed;
    right: 1rem;
    bottom: calc(var(--portfolio-status-height, 0px) + 1rem);
    z-index: 40;
    max-width: min(22rem, calc(100vw - 2rem));
    padding: 0.875rem 1rem;
    border-color: var(--primary);
  }

  .hero-controls {
    display: flex;
    align-items: center;
    margin-block: -0.3rem;
    margin-inline-start: -0.4rem;
  }

  /* 24px targets keep WCAG 2.5.8 spacing while the dots stay 0.62rem. */
  .hero-control {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
  }

  .hero-control:disabled {
    cursor: default;
  }

  .hero-control-dot {
    display: grid;
    place-items: center;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 9999px;
    transition:
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 160ms ease;
  }

  .hero-control-glyph {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1;
    color: rgb(0 0 0 / 0.6);
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .hero-controls:hover .hero-control-glyph,
  .hero-control:focus-visible .hero-control-glyph {
    opacity: 1;
  }

  .hero-control:hover .hero-control-dot {
    transform: scale(1.15);
  }

  .hero-control:active .hero-control-dot {
    filter: brightness(0.85);
  }

  .hero-control:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
    border-radius: 9999px;
  }

  .hero-control:disabled .hero-control-dot {
    filter: saturate(0.4);
    transform: none;
  }

  .tagline {
    transition:
      opacity 300ms ease,
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tagline.is-leaving {
    opacity: 0;
    transform: translateY(-0.4rem);
  }

  .tagline.is-entering {
    opacity: 0;
    transform: translateY(0.4rem);
  }

  .hero-primary-action:focus-visible,
  .hero-secondary-action:focus-visible,
  .hero-scroll:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .hero-primary-action:active,
  .hero-secondary-action:active,
  .hero-scroll:active {
    color: var(--primary-hover);
  }

  .hero-primary-action:active {
    border-color: var(--primary-hover);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      filter: blur(3px);
      transform: translateY(1.25rem);
      clip-path: inset(0 0 6% 0);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
      clip-path: inset(0);
    }
  }

  @media (min-width: 640px) {
    .hero-command {
      font-size: 1rem;
    }
  }

  @media (max-width: 520px) {
    .hero-line {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.2rem;
    }

    /* Indent by the command row's "$ " width, measured in its own 0.875rem
       type (JetBrains Mono advances 0.6em per glyph) so the larger h1 lines
       up with the other outputs. */
    .hero-line > :not(.hero-command) {
      padding-left: calc(1.55 * 0.6 * 0.875rem);
    }
  }

  @media (max-height: 700px) {
    .hero-content {
      padding-top: 5rem;
      padding-bottom: 1.5rem;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-control:hover .hero-control-dot {
      transform: none;
    }

    .hero-enter,
    .tagline {
      opacity: 1;
      filter: none;
      transform: none;
      clip-path: none;
    }
  }
</style>
