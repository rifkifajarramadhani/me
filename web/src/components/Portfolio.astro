---
import Nav from '@/components/Nav.astro'
import Hero from '@/components/sections/Hero.astro'
import About from '@/components/sections/About.astro'
import Skills from '@/components/sections/Skills.astro'
import Experience from '@/components/sections/Experience.astro'
import Projects from '@/components/sections/Projects.astro'
import Contact from '@/components/sections/Contact.astro'
import TerminalBackdrop from '@/components/TerminalBackdrop.astro'
import DataStreams from '@/components/DataStreams.astro'
import { shortName } from '@/lib/site'

const year = new Date().getFullYear()
---

<Nav />
<TerminalBackdrop />
<DataStreams />
<main class="relative z-[1]">
  <Hero />
  <About />
  <Skills />
  <Experience />
  <Projects />
  <Contact />
</main>
<footer class="relative z-[1] hidden h-9 items-stretch border-t border-hairline bg-surface-1 font-mono text-xs text-ink-tertiary md:flex">
  <span class="flex h-full items-center bg-primary px-3 font-bold text-primary-foreground">
    NORMAL
  </span>
  <div class="flex flex-1 items-center justify-between px-4">
    <span class="text-ink-subtle">~/{shortName.toLowerCase()}</span>
    <span class="flex items-center gap-4">
      <span>© {year}</span>
      <span class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-success"></span>
        operational
      </span>
    </span>
  </div>
</footer>
<footer class="relative z-[1] border-t border-hairline bg-surface-1 py-4 text-center font-mono text-xs text-ink-tertiary md:hidden">
  <span class="text-ink-subtle">~/{shortName.toLowerCase()}</span>
  <span class="mx-2 text-prompt">·</span>
  <span>© {year}</span>
</footer>

<script>
  import { mountDataStreams } from '@/motion/data-streams'
  import { mountTaglineRotator } from '@/motion/tagline-rotator'
  import { mountTerminalBackdrop } from '@/motion/terminal-backdrop'

  const terminal = document.querySelector<HTMLElement>('[data-term-backdrop]')
  const hero = document.querySelector<HTMLElement>('#hero')
  if (terminal) mountTerminalBackdrop(terminal, hero)

  const canvas = document.querySelector<HTMLCanvasElement>('[data-data-streams]')
  if (canvas) mountDataStreams(canvas)

  const rotator = document.querySelector<HTMLElement>('#tagline-rotator')
  if (rotator) mountTaglineRotator(rotator)
</script>
