---
/**
 * Ambient terminal session pinned behind the whole page. Purely decorative: it
 * is hidden from assistive technology, pauses in background tabs, and renders
 * as a static transcript for reduced motion or no JavaScript. It never sits
 * under reading content: wide screens keep it in the left margin, and narrower
 * screens show it only behind the hero, fading it out (and pausing it) once
 * the hero scrolls away.
 */

import type { TerminalLine } from '@/motion/terminal-backdrop'

const script: TerminalLine[] = [
  { kind: 'cmd', text: 'git pull --rebase' },
  { kind: 'out', text: 'Already up to date.' },
  { kind: 'cmd', text: 'bun run check' },
  { kind: 'ok', text: 'lint ...... ok' },
  { kind: 'ok', text: 'typecheck . ok' },
  { kind: 'ok', text: 'tests ..... ok' },
  { kind: 'cmd', text: 'go test ./...' },
  { kind: 'ok', text: 'api/orders   0.42s' },
  { kind: 'ok', text: 'api/stock    0.31s' },
  { kind: 'cmd', text: 'php artisan migrate' },
  { kind: 'out', text: 'Nothing to migrate.' },
  { kind: 'cmd', text: 'docker compose up' },
  { kind: 'ok', text: 'postgres  healthy' },
  { kind: 'ok', text: 'api       started' },
  { kind: 'ok', text: 'web       started' },
  { kind: 'cmd', text: 'curl :8080/healthz' },
  { kind: 'out', text: '{"status":"ok"}' },
  { kind: 'cmd', text: 'bun run build' },
  { kind: 'ok', text: 'built in 3.1s' },
  { kind: 'cmd', text: 'git push' },
  { kind: 'out', text: 'main -> main' },
  { kind: 'cmd', text: 'tail -f access.log' },
  { kind: 'out', text: 'GET /             200' },
  { kind: 'out', text: 'GET /api/products 200' },
  { kind: 'out', text: 'POST /api/orders  201' },
  { kind: 'cmd', text: 'clear' },
]
---

<div
  class="term-backdrop"
  aria-hidden="true"
  data-term-backdrop
  data-script={JSON.stringify(script)}
>
  <div class="term-backdrop__log" data-term-log>
    {script.map((line) => (
      <div class:list={['term-backdrop__line', `is-${line.kind}`]}>
        {line.kind === 'cmd' && <span class="term-backdrop__prompt">$ </span>}
        {line.text}
      </div>
    ))}
  </div>
</div>

<style is:global>
  .term-backdrop {
    --term-opacity: 0.5;
    --term-dim: 1;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: calc(var(--term-opacity) * var(--term-dim));
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 18%,
      #000 78%,
      transparent 100%
    );
  }

  .dark .term-backdrop {
    --term-opacity: 0.55;
  }

  /* Past the hero the log would run under headings and copy, so on screens
     without a usable margin it leaves entirely rather than adding noise. */
  .term-backdrop[data-dim] {
    --term-dim: 0;
  }

  /* Wide screens: keep the session in the left margin, clear of the 56rem
     content column, so it can stay at full strength on every section. */
  @media (min-width: 80rem) {
    .term-backdrop[data-dim] {
      --term-dim: 1;
    }

    /* The margin is only ~22 columns wide at 80rem, so the script is
       written to fit and anything longer wraps instead of being clipped. */
    .term-backdrop .term-backdrop__log {
      right: auto;
      width: calc((100% - 56rem) / 2);
      padding-inline: 1.5rem 0.5rem;
    }
  }

  /* With JS and motion allowed, hold the static transcript back until the
     script has cleared it, so the session appears to start fresh. */
  @media (prefers-reduced-motion: no-preference) {
    .js .term-backdrop:not([data-ready]) {
      opacity: 0;
      transition: none;
    }
  }

  .term-backdrop__log {
    position: absolute;
    inset: 4.5rem 0 1rem;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.75;
    color: var(--ink-tertiary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Hanging indent: a wrapped line continues under its text, not its
     prompt, so it still reads as one line of output. */
  .term-backdrop__line {
    padding-left: 2ch;
    text-indent: -2ch;
  }

  .term-backdrop__line.is-cmd {
    color: var(--ink-subtle);
  }

  .term-backdrop__prompt {
    color: var(--primary);
  }

  .term-backdrop__line.is-ok::before {
    content: '\2713  ';
    color: var(--primary);
  }

  .term-backdrop__caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-left: 0.15ch;
    vertical-align: -0.16em;
    background: var(--ink-subtle);
    animation: command-caret-blink 1.05s steps(1) infinite;
  }
</style>

<script>
  import { mountTerminalBackdrop } from '@/motion/terminal-backdrop'

  const root = document.querySelector<HTMLElement>('[data-term-backdrop]')
  const hero = document.querySelector<HTMLElement>('#hero')
  if (root) mountTerminalBackdrop(root, hero)
</script>
