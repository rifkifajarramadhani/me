---
import BlogFrame from './BlogFrame.astro'
import { name, socialLinks } from '@/lib/site'
import { createSitePublishing } from '@/lib/site-publishing'
import { serializeJsonLd } from '@/lib/json-ld'
import {
  BlogUnavailable,
  formatLongDate,
  formatReadingTime,
  getPost,
  type BlogPost,
} from '@/lib/blog'

const publishing = createSitePublishing()
const slug = Astro.params.slug ?? ''
let post: BlogPost | undefined
let unavailable = false
try {
  post = await getPost(slug)
} catch (error) {
  if (!(error instanceof BlogUnavailable)) throw error
  unavailable = true
}

if (post) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60')
} else {
  Astro.response.status = unavailable ? 503 : 404
  Astro.response.headers.set('Cache-Control', 'no-store')
  if (unavailable) Astro.response.headers.set('Retry-After', '60')
}

const blogPath = publishing.publicPath('blog/')
const jsonLd = post && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  url: publishing.absoluteUrl(`blog/${post.slug}/`),
  author: { '@type': 'Person', name, url: socialLinks.github },
}
---

<BlogFrame
  title={post ? `${post.title} | ${name}` : `Post not found | ${name}`}
  description={post?.excerpt}
  noindex={!post}
>
  {jsonLd && <script slot="head" type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

  <a
    href={blogPath}
    class="inline-flex min-h-11 items-center text-sm text-ink-subtle transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  >
    <span class="text-prompt">[</span>&nbsp;cd ../blog&nbsp;<span class="text-prompt">]</span>
  </a>

  {
    post ? (
      <article class="mt-8">
        <header class="mb-12 border-b border-hairline pb-8">
          <p class="text-xs text-ink-subtle">
            <span class="mr-[0.4ch] text-prompt">$</span>cat ~/blog/{post.slug}.md
          </p>
          <h1 class="mt-3 max-w-[30ch] text-2xl font-bold leading-tight tracking-[-0.03em] text-ink text-balance sm:text-4xl">
            {post.title}
          </h1>
          <p class="mt-5 text-xs text-ink-subtle">
            <time datetime={post.publishedAt}>{formatLongDate(post.publishedAt)}</time>
            <span class="mx-2 text-prompt" aria-hidden="true">·</span>
            {formatReadingTime(post.readingMinutes)}
          </p>
        </header>
        <div class="prose-post" set:html={post.html} />
        <footer class="mt-16 border-t border-hairline pt-6">
          <a
            href={blogPath}
            class="inline-flex min-h-11 items-center border border-hairline-strong px-3 text-sm text-ink-subtle transition-colors hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span class="text-prompt">[</span>&nbsp;all posts&nbsp;<span class="text-prompt">]</span>
          </a>
        </footer>
      </article>
    ) : (
      <div class="mt-8">
        <h1 class="text-2xl font-bold text-ink sm:text-3xl">
          <span class="mr-[0.4ch] text-prompt">$</span>
          {unavailable ? 'blog unavailable' : 'post not found'}
        </h1>
        <p role={unavailable ? 'alert' : undefined} class="mt-4 text-sm leading-[1.7] text-ink-muted">
          {unavailable
            ? 'The blog is unavailable right now. Try again in a minute.'
            : 'No published post lives at this address. It may have been unpublished or moved.'}
        </p>
      </div>
    )
  }
</BlogFrame>
