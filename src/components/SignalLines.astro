---
/**
 * Ambient signal traces: thin Operational Green routes with occasional pulses
 * travelling along them, like requests moving through a network. Purely
 * decorative and hidden from assistive technology.
 *
 * Placement keeps them off reading content:
 * - From 80rem up they fill the right margin beside the 56rem column,
 *   balancing the terminal session in the left margin, and stay pinned to the
 *   viewport.
 * - Below that they live only in the hero, in the bands above and below the
 *   terminal card (which is opaque, so routes can plug into its edges), and
 *   scroll away with it.
 *
 * Guides are static at very low alpha; only the pulses move. Pulses pause in
 * background tabs, off-screen, and under reduced motion, where only the
 * static guides are drawn.
 */
---

<canvas class="signal-lines" aria-hidden="true" data-signal-lines></canvas>

<style is:global>
  .signal-lines {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .signal-lines[data-ready] {
    opacity: 1;
  }

  /* Wide screens: pinned to the viewport like the terminal session, faded in
     under the fixed navigation and out at the bottom edge. */
  @media (min-width: 80rem) {
    .signal-lines {
      position: fixed;
      mask-image: linear-gradient(
        to bottom,
        transparent 3.5rem,
        #000 8rem,
        #000 calc(100% - 6rem),
        transparent 100%
      );
    }
  }
</style>

<script>
  type Point = { x: number; y: number }
  type Route = {
    points: Point[]
    lengths: number[]
    total: number
    node: Point | null
    // Where the static guide starts; branches share the trunk before this.
    guideFrom: number
  }
  type Pulse = { route: Route; at: number; speed: number }
  type Flash = { node: Point; born: number }

  const canvas = document.querySelector<HTMLCanvasElement>('[data-signal-lines]')
  const ctx = canvas?.getContext('2d')
  const hero = document.querySelector<HTMLElement>('#hero')

  if (canvas && ctx && hero) {
    const GRID = 24
    const COLUMN = 56 // rem, matches the content column cap
    const NAV = 72
    const TAIL = 72
    const FLASH_MS = 700
    const FRAME_MS = 1000 / 30

    const wide = window.matchMedia('(min-width: 80rem)')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    let routes: Route[] = []
    let pulses: Pulse[] = []
    let flashes: Flash[] = []
    let guides: HTMLCanvasElement | null = null
    let color = '63, 185, 80'
    let alpha = { guide: 0.1, node: 0.22, pulse: 0.42 }
    let dpr = 1
    let width = 0
    let height = 0
    let crisp = 0
    let frame: number | undefined
    let last = 0
    let nextSpawn = 0
    let onScreen = true

    const rand = (min: number, max: number) => min + Math.random() * (max - min)
    const randInt = (min: number, max: number) =>
      Math.floor(rand(min, max + 1))
    const snap = (value: number, origin = 0) =>
      origin + Math.round((value - origin) / GRID) * GRID

    const makeRoute = (
      points: Point[],
      ends: boolean,
      guideFrom = 0,
    ): Route => {
      const lengths = [0]
      for (let i = 1; i < points.length; i += 1) {
        const a = points[i - 1]
        const b = points[i]
        lengths.push(lengths[i - 1] + Math.abs(b.x - a.x) + Math.abs(b.y - a.y))
      }
      return {
        points,
        lengths,
        total: lengths[lengths.length - 1],
        node: ends ? points[points.length - 1] : null,
        guideFrom,
      }
    }

    const readTheme = () => {
      const root = document.documentElement
      const hex = getComputedStyle(root).getPropertyValue('--primary').trim()
      const match = /^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(hex)
      if (match)
        color = match
          .slice(1)
          .map((part) => parseInt(part, 16))
          .join(', ')
      // Paper needs a touch more alpha for the same presence as Carbon.
      alpha = root.classList.contains('dark')
        ? { guide: 0.1, node: 0.22, pulse: 0.42 }
        : { guide: 0.22, node: 0.4, pulse: 0.5 }
    }

    // Right margin beside the content column, top to bottom.
    const wideRoutes = (): Route[] => {
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize)
      const columnRight = (width + COLUMN * rem) / 2
      const rail = Math.ceil((columnRight + GRID) / GRID) * GRID
      const limit = width - GRID
      const top = NAV
      const bottom = height - GRID
      if (limit - rail < GRID * 4) return []

      const list: Route[] = []
      const trunk: Point[] = [
        { x: rail, y: top },
        { x: rail, y: bottom },
      ]
      list.push(makeRoute(trunk, false))

      for (let y = top + GRID * 3; y < bottom - GRID * 3; y += GRID * randInt(4, 7)) {
        const points: Point[] = [
          { x: rail, y: top },
          { x: rail, y },
        ]
        let x = Math.min(limit, rail + GRID * randInt(2, 4))
        points.push({ x, y })
        if (Math.random() < 0.6 && x < limit - GRID * 2) {
          const dy = GRID * randInt(1, 2) * (Math.random() < 0.5 ? -1 : 1)
          const jogY = Math.min(bottom - GRID, Math.max(top + GRID * 2, y + dy))
          points.push({ x, y: jogY })
          x = Math.min(limit, x + GRID * randInt(1, 4))
          points.push({ x, y: jogY })
        }
        const exits = x >= limit
        list.push(makeRoute(points, !exits, y - top))
      }
      return list
    }

    // Hero bands above and below the terminal card, right of the session log.
    const heroRoutes = (): Route[] => {
      const card = hero.querySelector<HTMLElement>('.terminal-window')
      if (!card) return []
      const heroBox = hero.getBoundingClientRect()
      const box = card.getBoundingClientRect()
      const cardTop = box.top - heroBox.top
      const cardBottom = box.bottom - heroBox.top
      const cardLeft = box.left - heroBox.left
      const cardRight = box.right - heroBox.left
      // The session log's widest line ends near here.
      const logRight = Math.min(width * 0.55, 260)
      const minX = Math.max(logRight, cardLeft + GRID)
      const maxX = cardRight - GRID
      const list: Route[] = []
      // One route per row, so parallel traces never stack on each other.
      const rows = new Set<number>()
      const freeRow = (y: number, min: number, max: number) => {
        for (const candidate of [y, y + GRID, y - GRID, y + GRID * 2, y - GRID * 2])
          if (candidate >= min && candidate <= max && !rows.has(candidate)) {
            rows.add(candidate)
            return candidate
          }
        return null
      }

      const above = { from: NAV + GRID / 2, to: cardTop }
      if (above.to - above.from >= GRID * 2 && maxX - minX >= GRID * 2) {
        const count = Math.min(3, Math.floor((maxX - minX) / (GRID * 4)))
        for (let i = 0; i < count; i += 1) {
          const portX = snap(maxX - i * GRID * randInt(3, 5))
          if (portX < minX) break
          const y = freeRow(
            snap(rand(above.from + GRID / 2, above.to - GRID)),
            above.from,
            above.to - GRID / 2,
          )
          if (y === null) continue
          // Enter from the right edge, then drop into the card's top border.
          list.push(
            makeRoute(
              [
                { x: width, y },
                { x: portX, y },
                { x: portX, y: cardTop },
              ],
              false,
            ),
          )
        }
      }

      const scroll = hero.querySelector<HTMLElement>('.hero-scroll')
      const scrollBox = scroll?.getBoundingClientRect()
      const scrollTop =
        scrollBox && scrollBox.height > 0
          ? scrollBox.top - heroBox.top
          : height
      const below = { from: cardBottom, to: Math.min(height, scrollTop) - GRID / 2 }
      const belowMinX = Math.max(width / 2 + GRID * 3, cardLeft + GRID)
      if (below.to - below.from >= GRID * 2 && maxX - belowMinX >= GRID) {
        const count = Math.min(2, Math.floor((maxX - belowMinX) / (GRID * 3)) + 1)
        for (let i = 0; i < count; i += 1) {
          const portX = snap(maxX - i * GRID * randInt(2, 4))
          if (portX < belowMinX) break
          const y = freeRow(
            snap(rand(below.from + GRID, below.to)),
            below.from + GRID / 2,
            below.to,
          )
          if (y === null) continue
          // Leave the card's bottom border, then run out to the right edge.
          list.push(
            makeRoute(
              [
                { x: portX, y: cardBottom },
                { x: portX, y },
                { x: width, y },
              ],
              false,
            ),
          )
        }
      }
      return list
    }

    const strokeRoute = (
      target: CanvasRenderingContext2D,
      route: Route,
      from: number,
      to: number,
    ) => {
      const start = pointAt(route, from)
      target.beginPath()
      target.moveTo(start.x + crisp, start.y + crisp)
      for (let i = 1; i < route.points.length; i += 1) {
        if (route.lengths[i] <= from) continue
        if (route.lengths[i] >= to) break
        const p = route.points[i]
        target.lineTo(p.x + crisp, p.y + crisp)
      }
      const end = pointAt(route, to)
      target.lineTo(end.x + crisp, end.y + crisp)
      target.stroke()
    }

    const pointAt = (route: Route, distance: number): Point => {
      const d = Math.max(0, Math.min(route.total, distance))
      for (let i = 1; i < route.points.length; i += 1) {
        if (route.lengths[i] >= d) {
          const a = route.points[i - 1]
          const b = route.points[i]
          const span = route.lengths[i] - route.lengths[i - 1] || 1
          const t = (d - route.lengths[i - 1]) / span
          return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }
        }
      }
      return route.points[route.points.length - 1]
    }

    const drawNode = (
      target: CanvasRenderingContext2D,
      node: Point,
      a: number,
    ) => {
      target.fillStyle = `rgba(${color}, ${a})`
      target.fillRect(node.x - 1.5, node.y - 1.5, 3, 3)
    }

    const paintGuides = () => {
      guides = document.createElement('canvas')
      guides.width = canvas.width
      guides.height = canvas.height
      const g = guides.getContext('2d')
      if (!g) return
      g.setTransform(dpr, 0, 0, dpr, 0, 0)
      g.lineWidth = 1
      g.strokeStyle = `rgba(${color}, ${alpha.guide})`
      for (const route of routes)
        strokeRoute(g, route, route.guideFrom, route.total)
      for (const route of routes)
        if (route.node) drawNode(g, route.node, alpha.node)
    }

    const draw = (now: number) => {
      ctx.setTransform(1, 0, 0, 1, 0, 0)
      ctx.clearRect(0, 0, canvas.width, canvas.height)
      if (guides) ctx.drawImage(guides, 0, 0)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.lineWidth = 1

      const steps = 12
      for (const pulse of pulses) {
        for (let k = 0; k < steps; k += 1) {
          const to = pulse.at - (k * TAIL) / steps
          const from = pulse.at - ((k + 1) * TAIL) / steps
          if (to <= 0) break
          const fade = (1 - k / steps) ** 1.6
          ctx.strokeStyle = `rgba(${color}, ${alpha.pulse * fade})`
          strokeRoute(ctx, pulse.route, Math.max(0, from), Math.min(to, pulse.route.total))
        }
      }

      for (const flash of flashes) {
        const t = (now - flash.born) / FLASH_MS
        const boost = (1 - t) ** 2
        drawNode(ctx, flash.node, alpha.node + (alpha.pulse + 0.2 - alpha.node) * boost)
      }
    }

    const spawn = (now: number) => {
      const candidates = routes.filter((route) => route.total > GRID * 3)
      if (!candidates.length) return
      // On wide screens the trunk itself carries traffic only occasionally.
      const branches = candidates.filter((route) => route.node || !wide.matches)
      const pool = branches.length && Math.random() < 0.85 ? branches : candidates
      const route = pool[Math.floor(Math.random() * pool.length)]
      pulses.push({ route, at: 0, speed: rand(150, 220) })
      nextSpawn = now + rand(wide.matches ? 900 : 1600, wide.matches ? 2400 : 3600)
    }

    const tick = (now: number) => {
      frame = window.requestAnimationFrame(tick)
      if (now - last < FRAME_MS) return
      const dt = last ? Math.min(100, now - last) / 1000 : 0
      last = now

      const maxPulses = wide.matches ? 4 : 2
      if (now >= nextSpawn && pulses.length < maxPulses) spawn(now)

      for (const pulse of pulses) pulse.at += pulse.speed * dt
      pulses = pulses.filter((pulse) => {
        if (pulse.at - TAIL < pulse.route.total) return true
        return false
      })
      for (const pulse of pulses)
        if (
          pulse.route.node &&
          pulse.at >= pulse.route.total &&
          !flashes.some((flash) => flash.node === pulse.route.node)
        )
          flashes.push({ node: pulse.route.node, born: now })
      flashes = flashes.filter((flash) => now - flash.born < FLASH_MS)

      draw(now)
    }

    const stop = () => {
      if (frame) window.cancelAnimationFrame(frame)
      frame = undefined
      last = 0
    }

    const start = () => {
      if (frame) return
      nextSpawn = performance.now() + 600
      frame = window.requestAnimationFrame(tick)
    }

    const sync = () => {
      const active =
        document.visibilityState === 'visible' &&
        !reducedMotion.matches &&
        (wide.matches || onScreen)
      if (active) start()
      else {
        stop()
        pulses = []
        flashes = []
        draw(performance.now())
      }
    }

    const layout = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2)
      crisp = Math.round(dpr) % 2 === 1 ? 0.5 : 0
      width = document.documentElement.clientWidth
      height = wide.matches ? window.innerHeight : hero.offsetHeight
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      canvas.style.width = `${width}px`
      canvas.style.height = `${height}px`
      routes = wide.matches ? wideRoutes() : heroRoutes()
      pulses = []
      flashes = []
      readTheme()
      paintGuides()
      draw(performance.now())
      sync()
    }

    let resizeTimer: number | undefined
    const scheduleLayout = () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(layout, 150)
    }

    new MutationObserver(() => {
      readTheme()
      paintGuides()
      draw(performance.now())
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })

    if ('IntersectionObserver' in window)
      new IntersectionObserver(([entry]) => {
        onScreen = entry.isIntersecting
        sync()
      }).observe(hero)

    window.addEventListener('resize', scheduleLayout)
    wide.addEventListener('change', layout)
    reducedMotion.addEventListener('change', sync)
    document.addEventListener('visibilitychange', sync)

    // Route against the hero card's settled box: wait for fonts (final size)
    // and its entrance animation (final position) before measuring.
    const card = hero.querySelector<HTMLElement>('.terminal-window')
    const settled = (card?.getAnimations() ?? []).map((animation) =>
      animation.finished.catch(() => undefined),
    )
    Promise.all([document.fonts?.ready, ...settled]).then(() => {
      layout()
      canvas.dataset.ready = ''
    })
  }
</script>
