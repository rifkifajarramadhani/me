---
import PAST_ROLES from '@/data/experience'
import Reveal from '@/components/Reveal.astro'
import SectionHeading from '@/components/SectionHeading.astro'
---

<section id="experience" class="mx-auto max-w-4xl px-6 py-24">
  <Reveal>
    <SectionHeading command="git log --experience" kicker="experience" />
  </Reveal>

  <div class="relative pl-8 md:pl-10">
    <div class="flex flex-col gap-10">
      {
        PAST_ROLES.map((role, index) => {
          const isCurrent = role.endDate.toLowerCase() === 'present'
          return (
            <Reveal delay={0.05 * index}>
              <div class="panel relative p-5">
                <span class="absolute -left-[2.05rem] top-6 font-mono text-xs text-primary md:-left-[2.55rem]">
                  {isCurrent ? '[ ]' : '[x]'}
                </span>
                <p class="mb-1 font-mono text-xs text-prompt">
                  {role.startDate} — {role.endDate}
                </p>
                <h3 class="text-lg font-semibold text-ink">
                  {role.role}{' '}
                  <span class="text-primary">@ {role.company}</span>
                </h3>
                <p class="mt-1 font-mono text-xs uppercase tracking-wider text-ink-tertiary">
                  {role.country}
                </p>
                <p class="mt-3 leading-[1.7] text-ink-muted">{role.description}</p>
              </div>
            </Reveal>
          )
        })
      }
    </div>
  </div>
</section>
