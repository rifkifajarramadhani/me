---
import PROJECTS from '@/data/projects'
import Reveal from '@/components/Reveal.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import ProjectLinks from '@/components/ProjectLinks.astro'
import { createSitePublishing } from '@/lib/site-publishing'

const featured = PROJECTS.filter((project) => project.featured)
const others = PROJECTS.filter((project) => !project.featured)
const publishing = createSitePublishing()
---

<section id="work" class="mx-auto max-w-4xl px-6 py-24">
  <Reveal>
    <SectionHeading command="ls projects/" kicker="work" />
  </Reveal>

  <div class="flex flex-col gap-14 md:gap-16">
    {
      featured.map((project, index) => {
        const previewHref =
          project.liveLink || (project.repoUrl !== '#' ? project.repoUrl : '')
        const previewLabel = project.liveLink
          ? `Open ${project.name} live site`
          : `Open ${project.name} repository`
        return (
          <Reveal>
            <article class="grid items-start gap-6 md:gap-8 lg:grid-cols-12 lg:items-center">
              <div class:list={['lg:col-span-7', index % 2 === 1 && 'lg:order-2']}>
                {previewHref ? (
                  <a
                    href={previewHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={previewLabel}
                    class="block overflow-hidden border border-hairline-strong transition-colors duration-200 hover:border-primary focus-visible:border-primary focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                  >
                    <img
                      src={publishing.publicPath(project.previewImage)}
                      alt={`${project.name} project interface preview`}
                      loading="lazy"
                      decoding="async"
                      class="block aspect-video w-full object-cover object-top"
                    />
                  </a>
                ) : (
                  <div class="block overflow-hidden border border-hairline-strong">
                    <img
                      src={publishing.publicPath(project.previewImage)}
                      alt={`${project.name} project interface preview`}
                      loading="lazy"
                      decoding="async"
                      class="block aspect-video w-full object-cover object-top"
                    />
                  </div>
                )}
                {project.tags && (
                  <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs leading-relaxed text-ink-subtle">
                    {project.tags.map((tag) => (
                      <li class="whitespace-nowrap">
                        <span class="text-prompt">[</span>
                        {tag}
                        <span class="text-prompt">]</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div class:list={['lg:col-span-5', index % 2 === 1 && 'lg:order-1']}>
                <p class="mb-2 font-mono text-xs text-primary">
                  <span class="text-prompt">[</span> featured{' '}
                  <span class="text-prompt">]</span>
                </p>
                <h3 class="mb-4 text-xl font-semibold text-ink">{project.name}</h3>
                <p class="panel p-5 text-sm leading-[1.7] text-ink-muted">
                  {project.description}
                </p>
                <div class="mt-4">
                  <ProjectLinks
                    projectName={project.name}
                    repoUrl={project.repoUrl}
                    liveLink={project.liveLink}
                  />
                </div>
              </div>
            </article>
          </Reveal>
        )
      })
    }
  </div>

  {
    others.length > 0 && (
      <div class="mt-20 grid gap-4 sm:grid-cols-2">
        {others.map((project, index) => (
          <Reveal delay={0.05 * index}>
            <article class="group panel flex h-full flex-col p-5 transition-colors duration-200 hover:border-primary focus-within:border-primary">
              <p class="mb-3 font-mono text-xs text-primary">
                <span class="text-prompt">[</span> project{' '}
                <span class="text-prompt">]</span>
              </p>
              <h3 class="mb-3 text-base font-semibold text-ink transition-colors group-hover:text-primary">
                {project.name}
              </h3>
              <p class="line-clamp-4 text-sm leading-[1.7] text-ink-muted">
                {project.description}
              </p>
              {project.tags && (
                <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs leading-relaxed text-ink-subtle">
                  {project.tags.map((tag) => (
                    <li class="whitespace-nowrap">
                      <span class="text-prompt">[</span>
                      {tag}
                      <span class="text-prompt">]</span>
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-auto pt-4">
                <ProjectLinks
                  projectName={project.name}
                  repoUrl={project.repoUrl}
                  liveLink={project.liveLink}
                />
              </div>
            </article>
          </Reveal>
        ))}
      </div>
    )
  }
</section>
