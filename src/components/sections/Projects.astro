---
import PROJECTS from '@/data/projects'
import Reveal from '@/components/Reveal.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import ProjectLinks from '@/components/ProjectLinks.astro'
import { withBase } from '@/lib/with-base'

const featured = PROJECTS.filter((project) => project.featured)
const others = PROJECTS.filter((project) => !project.featured)
---

<section id="work" class="mx-auto max-w-4xl px-6 py-24">
  <Reveal>
    <SectionHeading command="ls projects/" kicker="work" />
  </Reveal>

  <div class="flex flex-col gap-16">
    {
      featured.map((project, index) => {
        const previewHref =
          project.liveLink || (project.repoUrl !== '#' ? project.repoUrl : '')
        return (
          <Reveal>
            <div class="grid items-start gap-6 md:grid-cols-12">
              <div class:list={['md:col-span-7', index % 2 === 1 && 'md:order-2']}>
                {previewHref ? (
                  <a
                    href={previewHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block overflow-hidden border border-hairline-strong"
                  >
                    <img
                      src={withBase(project.previewImage)}
                      alt={project.name}
                      loading="lazy"
                      class="aspect-video w-full object-cover object-top transition-opacity duration-300 group-hover:opacity-90"
                    />
                  </a>
                ) : (
                  <div class="group block overflow-hidden border border-hairline-strong">
                    <img
                      src={withBase(project.previewImage)}
                      alt={project.name}
                      loading="lazy"
                      class="aspect-video w-full object-cover object-top transition-opacity duration-300 group-hover:opacity-90"
                    />
                  </div>
                )}
                {project.tags && (
                  <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-ink-subtle">
                    {project.tags.map((tag) => (
                      <li>
                        <span class="text-prompt">[</span>
                        {tag}
                        <span class="text-prompt">]</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div class:list={['md:col-span-5', index % 2 === 1 && 'md:order-1']}>
                <p class="mb-2 font-mono text-xs text-primary">
                  <span class="text-prompt">[</span>featured<span class="text-prompt">
                    ]</span
                  >
                </p>
                <h3 class="mb-4 text-xl font-semibold text-ink">{project.name}</h3>
                <div class="panel p-5 text-sm leading-[1.7] text-ink-muted">
                  {project.description}
                </div>
                <div class="mt-4">
                  <ProjectLinks
                    repoUrl={project.repoUrl}
                    liveLink={project.liveLink}
                  />
                </div>
              </div>
            </div>
          </Reveal>
        )
      })
    }
  </div>

  {
    others.length > 0 && (
      <div class="mt-20 grid gap-4 sm:grid-cols-2">
        {others.map((project, index) => (
          <Reveal delay={0.05 * index}>
            <div class="group panel flex h-full flex-col p-5 transition-colors hover:border-primary">
              <div class="mb-4 flex items-center justify-between">
                <span class="font-mono text-xs text-ink-tertiary">
                  <span class="text-prompt">[+]</span> {project.name}
                </span>
                <ProjectLinks repoUrl={project.repoUrl} liveLink={project.liveLink} />
              </div>
              <h3 class="mb-2 text-base font-semibold text-ink transition-colors group-hover:text-primary">
                {project.name}
              </h3>
              <p class="line-clamp-4 text-sm leading-[1.7] text-ink-muted">
                {project.description}
              </p>
            </div>
          </Reveal>
        ))}
      </div>
    )
  }
</section>
