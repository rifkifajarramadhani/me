---
import { name, jobTitle, socialLinks } from '@/lib/site'

const taglines = ['build things for the web.', 'build digital experiences.']
const socials = [
  { href: socialLinks.github, label: 'github' },
  { href: socialLinks.email, label: 'email' },
  { href: socialLinks.linkedin, label: 'linkedin' },
]
---

<section
  id="hero"
  class="relative mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-6 pt-20"
>
  <div class="terminal-window hero-enter">
    <div class="terminal-titlebar">
      <div class="flex items-center gap-1.5">
        <span class="size-[0.62rem] rounded-full bg-danger"></span>
        <span class="size-[0.62rem] rounded-full bg-warning"></span>
        <span class="size-[0.62rem] rounded-full bg-success"></span>
      </div>
      <span class="font-mono text-xs text-ink-tertiary">~/portfolio</span>
    </div>

    <div class="space-y-3 p-6 sm:p-8">
      <div class="font-mono text-sm leading-relaxed sm:text-base">
        <span class="mr-[0.4ch] text-prompt">$</span><span class="text-ink-subtle">whoami</span>{' '}
        <h1 class="inline font-mono text-xl font-semibold tracking-[-0.02em] text-ink sm:text-2xl">
          {name}
        </h1>
      </div>

      <p class="font-mono text-sm leading-relaxed sm:text-base">
        <span class="mr-[0.4ch] text-prompt">$</span><span class="text-ink-subtle">cat role.txt</span>{' '}
        <span class="text-ink">{jobTitle}</span>
      </p>

      <div
        id="tagline-rotator"
        class="flex flex-wrap items-baseline gap-x-2 font-mono text-sm sm:text-base"
        data-taglines={JSON.stringify(taglines)}
      >
        <span class="text-prompt">$</span><span class="text-ink-subtle">echo</span>
        <span data-tagline class="tagline text-primary">&quot;{taglines[0]}&quot;</span>
        <span class="inline-block h-[1.05em] w-[0.55ch] translate-y-[0.12em] animate-command-caret bg-primary motion-reduce:animate-none"></span>
      </div>

      <p class="max-w-xl pt-2 font-mono text-sm leading-[1.7] text-ink-muted">
        Full-stack software engineer based in Indonesia, building web applications
        since 2018 with TypeScript, Golang, PHP, React, Vue, and Tailwind CSS.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="#work"
          class="border border-hairline-strong px-4 py-2 font-mono text-sm text-ink-subtle transition-colors hover:border-primary hover:text-primary"
        >
          <span class="text-prompt">[</span> view work <span class="text-prompt">]</span>
        </a>
        <div class="flex flex-wrap items-center gap-3">
          {
            socials.map(({ href, label }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class="font-mono text-sm text-ink-subtle transition-colors hover:text-primary"
              >
                <span class="text-prompt">[</span> {label}{' '}
                <span class="text-prompt">]</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 font-mono text-xs text-ink-tertiary transition-colors hover:text-primary"
    aria-label="Scroll to about"
  >
    <span class="text-prompt">[</span> scroll <span class="text-prompt">]</span>
  </a>
</section>

<script>
  const rotator = document.querySelector('#tagline-rotator')
  const tagline = rotator?.querySelector('[data-tagline]')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (rotator && tagline && !reducedMotion.matches) {
    const taglines = JSON.parse(rotator.dataset.taglines ?? '[]')
    let index = 0

    if (taglines.length > 1) {
      window.setInterval(() => {
        tagline.classList.add('is-leaving')

        window.setTimeout(() => {
          index = (index + 1) % taglines.length
          tagline.textContent = `"${taglines[index]}"`
          tagline.classList.remove('is-leaving')
          tagline.classList.add('is-entering')
          requestAnimationFrame(() => tagline.classList.remove('is-entering'))
        }, 350)
      }, 3500)
    }
  }
</script>
