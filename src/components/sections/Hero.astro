---
import { name, jobTitle, socialLinks } from '@/lib/site'

const taglines = ['build things for the web.', 'build digital experiences.']
const socials = [
  {
    href: socialLinks.github,
    label: 'github',
    accessibleLabel: 'GitHub profile (opens in a new tab)',
    external: true,
  },
  {
    href: socialLinks.email,
    label: 'email',
    accessibleLabel: 'Email Rifki',
    external: false,
  },
  {
    href: socialLinks.linkedin,
    label: 'linkedin',
    accessibleLabel: 'LinkedIn profile (opens in a new tab)',
    external: true,
  },
]
---

<section
  id="hero"
  class="hero-section relative mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-5 pb-24 pt-24 sm:px-6 sm:pb-28 sm:pt-28"
>
  <div class="terminal-window hero-enter">
    <div class="terminal-titlebar">
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="size-[0.62rem] rounded-full bg-danger"></span>
        <span class="size-[0.62rem] rounded-full bg-warning"></span>
        <span class="size-[0.62rem] rounded-full bg-success"></span>
      </div>
      <span class="font-mono text-xs text-ink-subtle" aria-hidden="true">
        ~/portfolio
      </span>
    </div>

    <div class="p-6 sm:p-8">
      <div class="hero-transcript">
        <div class="hero-line">
          <p class="hero-command" aria-hidden="true">
            <span class="text-prompt">$</span>
            <span class="text-ink-subtle">whoami</span>
          </p>
          <h1 class="font-mono text-2xl font-semibold leading-tight tracking-[-0.02em] text-ink">
            {name}
          </h1>
        </div>

        <div class="hero-line">
          <p class="hero-command" aria-hidden="true">
            <span class="text-prompt">$</span>
            <span class="text-ink-subtle">cat role.txt</span>
          </p>
          <p class="font-mono text-sm leading-relaxed text-ink sm:text-base">
            <span class="sr-only">Role: </span>
            {jobTitle}
          </p>
        </div>

        <div
          id="tagline-rotator"
          class="hero-line"
          data-taglines={JSON.stringify(taglines)}
        >
          <p class="hero-command" aria-hidden="true">
            <span class="text-prompt">$</span>
            <span class="text-ink-subtle">echo</span>
          </p>
          <p class="flex min-w-0 items-baseline font-mono text-sm leading-relaxed sm:text-base">
            <span data-tagline class="tagline text-primary">
              &quot;{taglines[0]}&quot;
            </span>
            <span
              class="ml-[0.55ch] inline-block h-[1.05em] w-[0.55ch] shrink-0 translate-y-[0.12em] animate-command-caret bg-primary motion-reduce:animate-none"
              aria-hidden="true"
            ></span>
          </p>
        </div>
      </div>

      <p class="mt-6 max-w-[68ch] font-mono text-sm leading-[1.75] text-ink-muted sm:text-[0.9375rem]">
        Full-stack software engineer based in Indonesia, building web
        applications since 2018 with TypeScript, Golang, PHP, React, Vue, and
        Tailwind CSS.
      </p>

      <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a
          href="#work"
          class="hero-primary-action inline-flex min-h-11 items-center border border-hairline-strong px-4 py-2 font-mono text-sm text-ink-subtle transition-colors hover:border-primary hover:text-primary"
        >
          <span class="text-prompt">[</span> view work{' '}
          <span class="text-prompt">]</span>
        </a>
        <div class="flex flex-wrap items-center gap-x-1 gap-y-1 sm:gap-x-2">
          {socials.map(({ href, label, accessibleLabel, external }) => (
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              aria-label={accessibleLabel}
              class="hero-secondary-action inline-flex min-h-11 items-center px-1 font-mono text-sm text-ink-subtle transition-colors hover:text-primary"
            >
              <span class="text-prompt">[</span> {label}{' '}
              <span class="text-prompt">]</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <a
    href="#about"
    class="hero-scroll absolute bottom-5 left-1/2 inline-flex min-h-11 -translate-x-1/2 items-center px-2 font-mono text-xs text-ink-subtle transition-colors hover:text-primary sm:bottom-7"
    aria-label="Scroll to about"
  >
    <span class="text-prompt">[</span> scroll <span class="text-prompt">]</span>
  </a>
</section>

<style>
  .hero-section {
    min-height: 100svh;
  }

  .hero-transcript {
    display: grid;
    gap: 1rem;
  }

  .hero-line {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0.75rem;
  }

  .hero-command {
    display: flex;
    gap: 0.55ch;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .hero-enter {
    animation: hero-enter 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .tagline {
    transition:
      opacity 300ms ease,
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tagline.is-leaving {
    opacity: 0;
    transform: translateY(-0.4rem);
  }

  .tagline.is-entering {
    opacity: 0;
    transform: translateY(0.4rem);
  }

  .hero-primary-action:focus-visible,
  .hero-secondary-action:focus-visible,
  .hero-scroll:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .hero-primary-action:active,
  .hero-secondary-action:active,
  .hero-scroll:active {
    color: var(--primary-hover);
  }

  .hero-primary-action:active {
    border-color: var(--primary-hover);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      filter: blur(3px);
      transform: translateY(1.25rem);
      clip-path: inset(0 0 6% 0);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
      clip-path: inset(0);
    }
  }

  @media (min-width: 640px) {
    .hero-command {
      font-size: 1rem;
    }
  }

  @media (max-width: 520px) {
    .hero-line {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.2rem;
    }

    .hero-line > :not(.hero-command) {
      padding-left: calc(1ch + 0.55ch);
    }
  }

  @media (max-height: 700px) {
    .hero-section {
      padding-top: 5rem;
      padding-bottom: 1.5rem;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter,
    .tagline {
      opacity: 1;
      filter: none;
      transform: none;
      clip-path: none;
    }
  }
</style>

<script>
  const rotator = document.querySelector('#tagline-rotator')
  const tagline = rotator?.querySelector('[data-tagline]')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (rotator && tagline) {
    const taglines = JSON.parse(rotator.dataset.taglines ?? '[]')
    let index = 0
    let intervalId
    let transitionId

    const stop = () => {
      if (intervalId) window.clearInterval(intervalId)
      if (transitionId) window.clearTimeout(transitionId)
      intervalId = undefined
      transitionId = undefined
      tagline.classList.remove('is-leaving', 'is-entering')
    }

    const rotate = () => {
      if (document.visibilityState !== 'visible' || reducedMotion.matches)
        return

      tagline.classList.add('is-leaving')
      transitionId = window.setTimeout(() => {
        index = (index + 1) % taglines.length
        tagline.textContent = `"${taglines[index]}"`
        tagline.classList.remove('is-leaving')
        tagline.classList.add('is-entering')
        requestAnimationFrame(() => tagline.classList.remove('is-entering'))
        transitionId = undefined
      }, 300)
    }

    const start = () => {
      if (taglines.length < 2 || intervalId || reducedMotion.matches) return
      intervalId = window.setInterval(rotate, 3500)
    }

    const sync = () => {
      if (document.visibilityState === 'visible' && !reducedMotion.matches) {
        start()
      } else {
        stop()
      }
    }

    const cleanup = () => {
      stop()
      document.removeEventListener('visibilitychange', sync)
      reducedMotion.removeEventListener('change', sync)
      window.removeEventListener('pagehide', handlePageHide)
      window.removeEventListener('pageshow', handlePageShow)
    }

    const handlePageHide = (event) => {
      if (event.persisted) {
        stop()
      } else {
        cleanup()
      }
    }

    const handlePageShow = (event) => {
      if (event.persisted) sync()
    }

    if (taglines.length > 1) {
      document.addEventListener('visibilitychange', sync)
      reducedMotion.addEventListener('change', sync)
      window.addEventListener('pagehide', handlePageHide)
      window.addEventListener('pageshow', handlePageShow)
      start()
    }
  }
</script>
