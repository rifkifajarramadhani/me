---
interface Props {
  command: string
  kicker?: string
  class?: string
}

const { command, kicker, class: className } = Astro.props
---

<!--
  Framed like a single-line prompt so the heading stays legible over the
  page-wide terminal backdrop. The kicker reads as the strip's path label.
-->
<div class={className}>
  <div class="flex items-center justify-between gap-4 border border-hairline bg-canvas px-4 py-3 text-left sm:px-5 sm:py-4">
    <h2 class="animate-rise-in text-2xl font-bold tracking-[-0.03em] text-ink motion-reduce:animate-none sm:text-3xl">
      <span class="mr-[0.4ch] text-prompt">$</span>
      {command}
      <span class="ml-[0.15ch] inline-block h-[1.05em] w-[0.55ch] translate-y-[0.16em] animate-command-caret bg-primary motion-reduce:animate-none"></span>
    </h2>
    {kicker && (
      <p class="hidden shrink-0 font-mono text-[0.72rem] font-bold tracking-[0.14em] text-ink-subtle uppercase sm:block">
        <span class="text-prompt">[</span>
        {kicker}
        <span class="text-prompt">]</span>
      </p>
    )}
  </div>
</div>
