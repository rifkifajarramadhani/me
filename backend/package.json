{
  "name": "me-cms",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run build && node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json && cp ../src/styles/tokens.css dist/tokens.css",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test test/*.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
